{
	"name": "xport",
	"version": "0.1.0",
	"description": "Obsidian plugin: exporteer de huidige notitie naar het klembord voor Outlook.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": ["obsidian", "obsidian-plugin", "outlook", "clipboard", "export"],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.14.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.0",
		"obsidian": "latest",
		"tslib": "2.6.3",
		"typescript": "5.5.4"
	}
}
